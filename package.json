  "main": "index.js",
  "scripts": {
    "setup-test-db": "npx prisma migrate dev --name init && npx prisma generate",
    "setup-prod-db": "npx prisma migrate deploy && npx prisma generate",
    "update-dev-db": "npx prisma migrate dev --name update && npx prisma generate",
