generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String         @id @unique
  firstName            String?        @map("first_name")
  lastName             String?        @map("last_name")
  email                String         @map("email")
  displayName          String         @map("display_name")
  imageUrl             String?        @map("image_url")
  isBanned             Boolean        @default(false) @map("is_banned")
  lastSeenAt           DateTime?      @map("last_seen_at")
  clerkUpdatedAt       DateTime?      @map("clerk_updated_at")
  syncedAt             DateTime       @default(now()) @map("synced_at")
  deletedAt            DateTime?      @map("deleted_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  memberships          Membership[]
  createdOrganizations Organization[] @relation("OrganizationCreator")

  @@map("user")
}

model Organization {
  id                            String                   @id @unique
  name                          String
  slug                          String                   @unique
  createdBy                     String                   @map("created_by")
  imageUrl                      String?                  @map("image_url")
  incidentGroupingWindowMinutes Int                      @default(10) @map("incident_grouping_window_minutes")
  autoInvestigateEnabled        Boolean                  @default(false) @map("auto_investigate_enabled")
  investigationLevel            AgentLevel               @default(low) @map("investigation_level")
  conversationLevel             AgentLevel               @default(low) @map("conversation_level")
  webSearchToolEnabled          Boolean                  @default(false) @map("web_search_tool_enabled")
  maxModelCalls                 Int                      @default(10) @map("max_model_calls")
  clerkUpdatedAt                DateTime?                @map("clerk_updated_at")
  syncedAt                      DateTime                 @default(now()) @map("synced_at")
  deletedAt                     DateTime?                @map("deleted_at")
  createdAt                     DateTime                 @default(now()) @map("created_at")
  updatedAt                     DateTime                 @updatedAt @map("updated_at")
  creator                       User                     @relation("OrganizationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  memberships                   Membership[]
  invitations                   OrganizationInvitation[]
  clusters                      Cluster[]
  alertSources                  AlertSource[]
  incidents                     Incident[]
  alerts                        Alert[]
  slackInstallation             SlackInstallation?
  mcpServers                    McpServer[]

  @@map("organization")
}

model Membership {
  id                String       @id @default(cuid())
  clerkMembershipId String       @unique @map("clerk_membership_id")
  organizationId    String       @map("organization_id")
  userId            String       @map("user_id")
  role              String       @default("org:member")
  clerkUpdatedAt    DateTime?    @map("clerk_updated_at")
  syncedAt          DateTime     @default(now()) @map("synced_at")
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("membership")
}

model OrganizationInvitation {
  id             String                       @id
  organizationId String                       @map("organization_id")
  emailAddress   String                       @map("email_address")
  role           String
  status         OrganizationInvitationStatus @default(PENDING)
  userId         String?                      @map("user_id")
  expiresAt      DateTime                     @map("expires_at")
  acceptedAt     DateTime?                    @map("accepted_at")
  revokedAt      DateTime?                    @map("revoked_at")
  clerkCreatedAt DateTime                     @map("clerk_created_at")
  clerkUpdatedAt DateTime?                    @map("clerk_updated_at")
  syncedAt       DateTime                     @default(now()) @map("synced_at")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([emailAddress])
  @@map("organization_invitation")
}

// A Kubernetes cluster with an in-cluster runner. `name` is the runner's CLUSTER_NAME and part of the gateway's ops URL.
model Cluster {
  id              String               @id @default(cuid())
  organizationId  String               @map("organization_id")
  name            String
  tokenHash       String               @unique @map("token_hash")
  lastConnectedAt DateTime?            @map("last_connected_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertSources    AlertSourceCluster[]
  incidents       Incident[]

  @@unique([organizationId, name])
  @@map("cluster")
}

// An Alertmanager/Grafana webhook sender. Its token covers only the clusters listed in AlertSourceCluster.
model AlertSource {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  name           String
  tokenHash      String               @unique @map("token_hash")
  clusterLabel   String               @default("cluster") @map("cluster_label")
  lastReceivedAt DateTime?            @map("last_received_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clusters       AlertSourceCluster[]
  alerts         Alert[]

  @@unique([organizationId, name])
  @@map("alert_source")
}

model AlertSourceCluster {
  alertSourceId String      @map("alert_source_id")
  clusterId     String      @map("cluster_id")
  alertSource   AlertSource @relation(fields: [alertSourceId], references: [id], onDelete: Cascade)
  cluster       Cluster     @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@id([alertSourceId, clusterId])
  @@index([clusterId])
  @@map("alert_source_cluster")
}

// A problem in one cluster that the agent investigates. clusterId null = alerts whose cluster we could not work out; not investigated.
model Incident {
  id                     String         @id @default(cuid())
  organizationId         String         @map("organization_id")
  clusterId              String?        @map("cluster_id")
  title                  String
  status                 IncidentStatus @default(OPEN)
  // Opened by a Grafana "Test" notification: never grouped with real alerts, never investigated.
  isTest                 Boolean        @default(false) @map("is_test")
  // When the first investigation started, manual or automatic. Set at most once, so an incident gets one automatic run.
  investigationStartedAt DateTime?      @map("investigation_started_at")
  slackChannelId         String?        @map("slack_channel_id")
  slackTs                String?        @map("slack_ts")
  resolvedAt             DateTime?      @map("resolved_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cluster                Cluster?       @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  alerts                 Alert[]

  @@index([organizationId, clusterId, status, createdAt])
  @@map("incident")
}

// One firing of one Alertmanager/Grafana alert. Repeats of the same firing share (fingerprint, startsAt).
model SlackInstallation {
  organizationId String       @id @map("organization_id")
  teamId         String       @unique @map("team_id") // The Slack workspace ID.
  teamName       String       @map("team_name") // The Slack workspace name.
  channelId      String       @map("channel_id")
  channelName    String       @map("channel_name")
  botUserId      String       @map("bot_user_id")
  encryptedToken Bytes        @map("encrypted_token")
  installedBy    String       @map("installed_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("slack_installation")
}

// A remote MCP server whose tools the org's agent runs can use. The name prefixes those tools.
model McpServer {
  id               String       @id @default(cuid())
  organizationId   String       @map("organization_id")
  name             String
  url              String
  // Exactly one of encryptedToken and encryptedHeaders is set.
  encryptedToken   Bytes?       @map("encrypted_token")
  encryptedHeaders Bytes?       @map("encrypted_headers")
  headerNames      String[]     @default([]) @map("header_names")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("mcp_server")
}

model Alert {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  incidentId     String       @map("incident_id")
  alertSourceId  String?      @map("alert_source_id")
  fingerprint    String
  status         AlertStatus  @default(FIRING)
  startsAt       DateTime     @map("starts_at")
  endsAt         DateTime?    @map("ends_at")
  labels         Json
  annotations    Json
  generatorUrl   String?      @map("generator_url")
  lastReceivedAt DateTime     @map("last_received_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident       Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  alertSource    AlertSource? @relation(fields: [alertSourceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, fingerprint, startsAt])
  @@index([incidentId, status])
  @@index([alertSourceId])
  @@map("alert")
}

model ClerkWebhookReceipt {
  id             String             @id
  eventType      String             @map("event_type")
  eventTimestamp DateTime           @map("event_timestamp")
  instanceId     String?            @map("instance_id")
  status         ClerkWebhookStatus @default(RECEIVED)
  attemptCount   Int                @default(1) @map("attempt_count")
  lastError      String?            @map("last_error") @db.Text
  receivedAt     DateTime           @default(now()) @map("received_at")
  processedAt    DateTime?          @map("processed_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([status, receivedAt])
  @@index([eventType, eventTimestamp])
  @@map("clerk_webhook_receipt")
}

enum AgentLevel {
  low
  medium
  high
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum AlertStatus {
  FIRING
  RESOLVED
}

enum ClerkWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}
