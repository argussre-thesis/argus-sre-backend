# Server configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database connection
DATABASE_URL=postgresql://username:password@localhost:5432/mydb?schema=public

# Clerk configuration
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Gateway uses this token to authenticate with the internal API, when verifying the runners token.
GATEWAY_BACKEND_TOKEN=

# Agent service (investigations). The token is the agent service's own INTERNAL_API_TOKEN,
# a different value from the one above.
AGENT_SERVICE_URL=http://127.0.0.1:8090
BACKEND_AGENT_SERVICE_TOKEN=

# Encrypts Slack bot tokens in the database. 32 bytes, base64: openssl rand -base64 32.
# Never change it once tokens are stored: they can't be decrypted with a new key.
TOKEN_ENCRYPTION_KEY=

# Slack app (api.slack.com/apps → Basic Information → App Credentials).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Signs the OAuth state: openssl rand -hex 32
SLACK_STATE_SECRET=
# This backend's callback, also listed under the app's OAuth & Permissions → Redirect URLs.
SLACK_REDIRECT_URL=https://staging.api.argussre.com/slack/v1/oauth/callback
# Proves an event came from Slack (Basic Information → App Credentials → Signing Secret).
SLACK_SIGNING_SECRET=
# How many of a thread's latest messages the agent gets, the mention included.
SLACK_THREAD_MESSAGES=5

# Frontend configuration (CORS)
FRONTEND_URL=http://localhost:3000
